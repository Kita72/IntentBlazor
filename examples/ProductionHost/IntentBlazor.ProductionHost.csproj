<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="appsettings.Local.json;appsettings.*.Local.json;**/*.publishsettings;**/*.pubxml.user" CopyToPublishDirectory="Never" />
    <None Update=".env;.env.*;**/*.publishsettings;**/*.pubxml.user" CopyToPublishDirectory="Never" />
    <ProjectReference Include="../../src/IntentBlazor.Blazor/IntentBlazor.Blazor.csproj" />
    <ProjectReference Include="../../src/IntentBlazor.Blazor.AI/IntentBlazor.Blazor.AI.csproj" />
    <ProjectReference Include="../../src/IntentBlazor.Content/IntentBlazor.Content.csproj" />
    <ProjectReference Include="../../src/IntentBlazor.Storage.Sqlite/IntentBlazor.Storage.Sqlite.csproj" />
  </ItemGroup>

</Project>
