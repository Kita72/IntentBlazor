@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject IExampleActor Actor
@inject ExampleWorkspaceController Workspaces
@inject IConfiguration Configuration
<PageTitle>Gaming News and Tips · IntentBlazor</PageTitle>
<main>
    @if (_signedIn)
    {
        <ExampleHeader />
        <p>@(Configuration["News:FeedUrl"] is { Length: > 0 } ? "News source: configured HTTPS JSON feed." : "News source: fictional games and articles. example.com links demonstrate attribution; these are not real gaming reports.")</p>
        <WorkspaceToolbar />
        <AiInput />
        <AiOutput />
        <ExampleAiTools />
    }
    else { <ExampleSignIn /> }
</main>
@code {
    private bool _signedIn;
    protected override async Task OnInitializedAsync() { _signedIn = await Actor.ReadAsync() is not null; if (_signedIn) await Workspaces.StartAsync(); }
}
