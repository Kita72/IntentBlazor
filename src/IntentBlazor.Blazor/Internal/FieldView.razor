@namespace IntentBlazor.Blazor.Internal
@using IntentBlazor.Core
@using IntentBlazor.Runtime
@using System.Globalization

@{ long revision = Session.Revision; }
<div class="ib-field" data-node="@Node.Id">
    <label for="@FieldId">@Node.Title</label>
    @if (Node.Kind == NodeKind.Select)
    {
        <select id="@FieldId" @bind:get="Value" @bind:set="(string? value) => Change(value, revision)">
            <option value="">Choose…</option>
            @foreach (var row in Session.Rows(Node))
            {
                string key = Session.RecordKey(Node, row);
                <option value="@key" @key="key">@JsonValues.Display(row[Node.LabelField!])</option>
            }
        </select>
    }
    else
    {
        <input id="@FieldId" type="@(Definition.Kind == StateKind.Number ? "number" : "text")"
               min="@Minimum" max="@Maximum" step="any" maxlength="4096"
               @bind:get="Value" @bind:set="(string? value) => Change(value, revision)" />
    }
</div>

@code {
    [Parameter, EditorRequired] public AiSession Session { get; set; } = default!;
    [Parameter, EditorRequired] public OutputNode Node { get; set; } = default!;
    private string FieldId => $"ib-{Session.Id}-{Node.Id}";
    private string Value => JsonValues.Display(Session.Snapshot.Values[Node.StateKey!]);
    private StateDefinition Definition => Session.Document!.State[Node.StateKey!];
    private string? Minimum => Definition.Minimum?.ToString(CultureInfo.InvariantCulture);
    private string? Maximum => Definition.Maximum?.ToString(CultureInfo.InvariantCulture);
    private void Change(string? value, long revision) => Session.Change(Node.Id, value ?? "", revision);
}
