@inherits LayoutComponentBase

<div class="site-shell">
    <header class="site-header">
        <a class="brand" href="/">IntentBlazor<span>AI application framework</span></a>
        <nav aria-label="Main navigation">
            <NavLink href="/" Match="NavLinkMatch.All">Overview</NavLink>
            <NavLink href="/architecture">Architecture</NavLink>
            <NavLink href="/playground">Playground</NavLink>
            <NavLink href="/models">Models</NavLink>
            <NavLink href="/workspaces">Recovery</NavLink>
            <NavLink href="/roadmap">Roadmap</NavLink>
            <NavLink href="/contribute">Contribute</NavLink>
            <a href="https://github.com/Kita72/IntentBlazor">GitHub</a>
        </nav>
