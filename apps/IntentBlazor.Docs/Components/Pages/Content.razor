@page "/content"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using IntentBlazor.Docs
@using IntentBlazor.Blazor
@using IntentBlazor.Blazor.AI
@using Microsoft.AspNetCore.Components.Authorization
@inject IEnumerable<ContentWorkspaceDemo> Demos
@inject AuthenticationStateProvider Authentication

<PageTitle>Content and extensions — IntentBlazor</PageTitle>
<p class="eyebrow">PHASE 4 · DETERMINISTIC CONTENT WORKSPACE</p>
<h1>Bring content.<br />Extend the workspace.</h1>
<p>Upload text, Markdown, JSON, CSV, PNG, JPEG, or a bounded text-based PDF through AiInput. AiOutput uses the same document for
    galleries, charts, authorized artifact previews, and a registered image-editor pack. The demo uses synthetic browser identities and makes no model calls.</p>
@if (!Demos.Any()) { <p class="status">This private-file demonstration is enabled only in Development.</p> }
else if (!_signedIn)
{
    <p class="status"><a href="/workspaces/demo-signin?returnUrl=/content" data-enhance-nav="false">Start my private content workspace</a>.</p>
}
else if (_demo is { } demo)
{
    <p class="status">Private workspace <code>@demo.Workspace.WorkspaceKey</code>. Uploads and derived previews are retained as immutable files.
        Select an attachment, then resize a PNG/JPEG or download its displayed artifact. A resize preserves the original.</p>
    <div class="actions">
        <button type="button" disabled="@demo.Workspace.IsBusy" @onclick="Sample">Create a synthetic 64×64 image</button>
        <button type="button" disabled="@demo.Workspace.IsBusy" @onclick="Refresh">Refresh attached content</button>
        <button type="button" disabled="@demo.Workspace.IsBusy" @onclick='() => Export("json")'>Export metadata as JSON</button>
        <button type="button" disabled="@demo.Workspace.IsBusy" @onclick='() => Export("csv")'>Export metadata as CSV</button>
    </div>
    @if (_message is not null) { <p role="status">@_message</p> }
    <AiInput Session="@demo.Workspace" Placeholder="For example: inspect my attached files and keep my current selection" />
    <AiOutput Session="@demo.Workspace" />
    <AiInspector Session="@demo.Workspace" />
    <AiSetup />
    <p>AI setup uses host-approved profiles when a model is configured. A connection probe is a separate explicit request;
        this deterministic content demo does not contact a model. No credentials are entered into or saved by these components.</p>
}

@code {
    private ContentWorkspaceDemo? _demo;
    private bool _signedIn, _disposed;
    private string? _message;
    protected override async Task OnInitializedAsync()
    {
        _signedIn = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true;
        if (!_signedIn || !Demos.Any()) return;
        _demo = Demos.Single(); _demo.Workspace.Changed += Changed;
        var result = await _demo.Workspace.ConnectAsync("content-demo");
        if (!result.Success) { _message = result.Errors[0].Message; return; }
        if (_demo.Workspace.Document is null) await _demo.RefreshAsync();
        await _demo.Workspace.FlushAsync();
    }
    private Task Sample() => Run(async demo => { await demo.AddSampleAsync(); _message = "Created an original MIT-licensed synthetic PNG. Select it below to inspect or resize it."; });
    private Task Refresh() => Run(async demo => { await demo.RefreshAsync(); _message = "The attached files were reauthorized and the content view refreshed."; });
    private Task Export(string format) => Run(async demo => { await demo.ExportAsync(format); _message = "Created an actual metadata export. Select it to preview or download the file."; });
    private async Task Run(Func<ContentWorkspaceDemo, Task> action)
    {
        if (_demo is null || _demo.Workspace.IsBusy) return;
        try { await action(_demo); }
        catch (Exception error) when (error is not OutOfMemoryException) { _message = "The content operation failed. Check current access and configured limits."; }
    }
    private async void Changed()
    {
        if (_disposed) return;
        try { await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
        catch (Exception error) { if (!_disposed) await DispatchExceptionAsync(error); }
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_demo is null) return;
        _demo.Workspace.Changed -= Changed; await _demo.Workspace.FlushAsync(); _demo.Dispose();
    }
}
